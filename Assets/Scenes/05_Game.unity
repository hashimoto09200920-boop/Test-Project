    - "\u5186\u306B\u306A\u308B\u3088\u3046\u306B\u7DDA\u3092\u7D20\u65E9\u304F\u5F15\u304F"
  - title: "\u7DDA\u306E\u672C\u6570\u3068\u6301\u7D9A\u6642\u9593"
    body: "\u7DDA\u306F\u3075\u3060\u30931\u672C\u3057\u304B\u5F15\u3051\u307E\u305B\u3093\u3002\n\u300C\u30DE\u30EB\u30C1\u30E9\u30A4\u30F3\u300D\u306E\u30B9\u30AD\u30EB\u3092\u53D6\u5F97\u3059\u308B\u3068\u3001\u540C\u6642\u306B\u5F15\u3051\u308B\u7DDA\u306E\u6570\u304C\u5897\u3048\u307E\u3059\u3002\n\u5F15\u3044\u305F\u7DDA\u306F\u6642\u9593\u7D4C\u904E\u3067\u6D88\u3048\u307E\u3059\u3002"
    illustration: {fileID: 0}
    requiresPractice: 1
    hints:
    - "\u7DDA\u304C\u6D88\u3048\u308B\u524D\u306B2\u672C\u76EE\u306E\u7DDA\u3092\u5F15\u304F"
    - "1\u672C\u306E\u7DDA\u30672\u3064\u306E\u5F3E\u3092\u53CD\u5C04\u3059\u308B"
  - title: "\u7DDA\u306E\u786C\u5EA6\u306B\u3064\u3044\u3066"
    body: "\u7DDA\u306B\u306F\u300C\u786C\u5EA6\u300D\u304C\u3042\u308A\u307E\u3059\u3002\n\u5F3E\u306E\u8CAB\u901A\u529B\u304C\u7DDA\u306E\u786C\u5EA6\u3092\u4E0A\u56DE\u308B\u3068\u3001\u7DDA\u306F\u7834\u3089\u308C\u3001\u8CAB\u901A\u3057\u307E\u3059\u3002\n\u300C\u30CF\u30FC\u30C9\u30E9\u30A4\u30F3\u300D\u306E\u30B9\u30AD\u30EB\u3092\u53D6\u5F97\u3059\u308B\u3068\u3001\u7DDA\u306E\u786C\u5EA6\u304C\u4E0A\u304C\u308A\u307E\u3059\u3002\n\u8CAB\u901A\u3057\u305F\u5F3E\u3092\u30012\u672C\u76EE\u306E\u7DDA\u3067\u53CD\u5C04\u3059\u308B\u3053\u3068\u304C\u3067\u304D\u307E\u3059\u3002"
    illustration: {fileID: 0}
    requiresPractice: 1
    hints:
    - "\u8CAB\u901A\u529B\u306E\u9AD8\u3044\u5F3E\u306B\u767D\u7DDA\u3092\u5F15\u304D\u3001\u5F3E\u304C\u7DDA\u3092\u8CAB\u901A\u3059\u308B\u3053\u3068\u3092\u78BA\u8A8D\u3059\u308B"
    - "\u786C\u5EA6\u304C\u4E0A\u304C\u3063\u305F\u767D\u7DDA\u3067\u3001\u5F3E\u3092\u53CD\u5C04\u3059\u308B"
    - "1\u672C\u76EE\u306E\u767D\u7DDA\u304C\u7834\u3089\u308C\u305F\u3089\u3001\u3059\u3050\u306B2\u672C\u76EE\u306E\u767D\u7DDA\u3092\u5F15\u304D\u5F3E\u3092\u53CD\u5C04\u3059\u308B"
  - title: "\u767D\u7DDA\u3068\u8D64\u7DDA\u306E\u9055\u3044"
    body: "\u767D\u7DDA\u306F\u7DDA\u30B2\u30FC\u30B8\u306E\u6D88\u8CBB\u304C\u5C11\u306A\u304F\u3001\u624B\u8EFD\u306B\u4F7F\u3046\u3053\u3068\u304C\u3067\u304D\u307E\u3059\u3002\n\u8D64\u7DDA\u306F\u7DDA\u30B2\u30FC\u30B8\u306E\u6D88\u8CBB\u304C\u591A\u3044\u4EE3\u308F\u308A\u306B\u3001\u7DDA\u306E\u6301\u7D9A\u6642\u9593\u30FB\u5F3E\u306E\u52A0\u901F\u30FB\u7DDA\u306E\u786C\u5EA6\u3001\u3044\u305A\u308C\u3082\u767D\u7DDA\u3092\u4E0A\u56DE\u308A\u307E\u3059\u3002\n\u72B6\u6CC1\u306B\u5FDC\u3058\u3066\u4F7F\u3044\u5206\u3051\u307E\u3057\u3087\u3046\u3002"
    illustration: {fileID: 0}
    requiresPractice: 1
    hints:
    - "\u9577\u62BC\u3057\u304B\u30C0\u30D6\u30EB\u30BF\u30C3\u30D7\u3067\u3001\u8D64\u7DDA\u3092\u5F15\u304F"
    - "\u8D64\u7DDA\u3067\u5F3E\u3092\u53CD\u5C04\u3057\u3001\u52E2\u3044\u3088\u304F\u5F3E\u304C\u8DF3\u306D\u8FD4\u308B\u306E\u3092\u78BA\u8A8D\u3059\u308B"
    - "\u8CAB\u901A\u529B\u306E\u9AD8\u3044\u5F3E\u3092\u8D64\u7DDA\u3067\u53CD\u5C04\u3057\u3001\u767D\u7DDA\u3088\u308A\u8D64\u7DDA\u306E\u786C\u5EA6\u304C\u9AD8\u3044\u3053\u3068\u3092\u78BA\u8A8D\u3059\u308B"
  - title: "\u7DDA\u30B2\u30FC\u30B8\u306B\u3064\u3044\u3066"
    body: "\u7DDA\u3092\u5F15\u304F\u3068\u30B2\u30FC\u30B8\u3092\u6D88\u8CBB\u3057\u307E\u3059\u3002\n\u4F7F\u3044\u5207\u308B\u3068\u30AA\u30FC\u30D0\u30FC\u30D2\u30FC\u30C8\u3057\u3001\u3057\u3070\u3089\u304F\u540C\u3058\u8272\u306E\u7DDA\u304C\u5F15\u3051\u306A\u304F\u306A\u308A\u307E\u3059\u3002"
    illustration: {fileID: 0}
    requiresPractice: 1
    hints:
    - "\u7DDA\u3092\u5F15\u3044\u3066\u7DDA\u30B2\u30FC\u30B8\u3092\u6D88\u8CBB\u3059\u308B"
    - "\u7DDA\u30B2\u30FC\u30B8\u3092\u4F7F\u3044\u5207\u308A\u3001\u30AA\u30FC\u30D0\u30FC\u30D2\u30FC\u30C8\u3092\u78BA\u8A8D\u3059\u308B"
  - title: "2\u3064\u306E\u4F53\u529B"
    body: "\u30C0\u30F3\u30B5\u30FC\u3068\u30D5\u30ED\u30A2\u306B\u305D\u308C\u305E\u308C\u4F53\u529B\u304C\u3042\u308A\u307E\u3059\u3002\n\u3069\u3061\u3089\u304B\u7247\u65B9\u304CHP0\u306B\u306A\u308B\u3068\u3001\u30C0\u30F3\u30B5\u30FC\u304C\u5012\u308C\u3066\u9B42\u304C\u629C\u3051\u51FA\u3057\u307E\u3059\u3002"
    illustration: {fileID: 0}
    requiresPractice: 1
    hints:
    - "\u6575\u306E\u5F3E\u3092\u53CD\u5C04\u305B\u305A\u30C0\u30E1\u30FC\u30B8\u3092\u53D7\u3051\u308B"
  - title: "\u9B42\u306E\u6551\u51FA"
    body: "HP0\u306B\u306A\u308B\u3068\u9B42\u304C\u753B\u9762\u4E0B\u3078\u843D\u3061\u3066\u3044\u304D\u307E\u3059\u3002\n\u753B\u9762\u5916\u306B\u843D\u3061\u308B\u524D\u306B\u3001\u9B42\u3092\u5186\u3067\u56F2\u3080\u3053\u3068\u3067\u6551\u51FA\u3067\u304D\u307E\u3059\u3002\n\u6551\u51FA\u6210\u529F\u3059\u308B\u3068\u4F53\u529B\u304C\u5168\u56DE\u5FA9\u3057\u307E\u3059\u3002"
    illustration: {fileID: 0}
    requiresPractice: 1
    hints:
    - "\u9B42\u3092\u5186\u3067\u56F2\u307F\u3001\u6551\u51FA\u3059\u308B"
  - title: "\u30B9\u30ED\u30FC\u30E2\u30FC\u30B7\u30E7\u30F3"
    body: "\u7802\u6642\u8A08\u30DC\u30BF\u30F3\u3067\u30B9\u30ED\u30FC\u30E2\u30FC\u30B7\u30E7\u30F3\u306B\u3067\u304D\u307E\u3059\u3002\n\u69D8\u3005\u306A\u6D3B\u7528\u65B9\u6CD5\u304C\u3042\u308B\u306E\u3067\u4E0A\u624B\u304F\u6D3B\u7528\u3057\u307E\u3057\u3087\u3046\u3002"
